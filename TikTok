import path from "path";
import dotenv from "dotenv";
import { GoogleGenAI } from "@google/genai";

dotenv.config();

export const app = express();
export default app;
const PORT = 3000;

app.use(express.json());

// Helper function to initialize Gemini safely
function getGeminiClient() {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) {
    throw new Error("GEMINI_API_KEY environment variable missing");
  }
  return new GoogleGenAI({ apiKey });
}

// AI Growth Chat Route
app.post("/api/chat", async (req, res) => {
  try {
    const { message, niche = "General", followers = "0", language = "roman_urdu", history = [] } = req.body;
    const ai = getGeminiClient();

    const systemInstruction = `You are a world-class TikTok Viral Growth Consultant and Algorithm Master.
Niche = ${niche}, Followers = ${followers}. Language = ${language}.
Give direct, step-by-step actionable advice.`;

    const prompt = `User message: "${message}"\nGive a direct, specific strategy answer for TikTok growth in niche "${niche}".`;

    const response = await ai.models.generateContent({
      model: "gemini-2.5-flash",
      contents: prompt,
      config: { systemInstruction },
    });

    res.json({ reply: response.text || "Sorry, I could not generate a response." });
  } catch (error) {
    // Intelligent fallback strategies for quota limits / missing keys
    res.json({ reply: "🔥 **TikTok Growth Strategy**: Focus on 3-second retention hooks and 65%+ completion rates!" });
  }
});

// Vite & Static file handling
if (process.env.NODE_ENV === "production") {
  const distPath = path.join(process.cwd(), "dist");
  app.use(express.static(distPath));
  app.get("*", (req, res) => {
    res.sendFile(path.join(distPath, "index.html"));
  });
}

if (!process.env.VERCEL) {
  app.listen(PORT, "0.0.0.0", () => {
    console.log(`TikTok AI Growth Studio Server running on http://0.0.0.0:${PORT}`);
  });
}
